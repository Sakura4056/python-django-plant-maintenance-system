# .env.example
# 环境变量配置示例文件
# 复制此文件为.env并根据实际环境修改配置值

# ============================================
# Django项目核心设置
# ============================================

# 调试模式开关
# True: 开发环境启用调试模式，便于开发和调试
# False: 生产环境禁用调试模式，提高安全性和性能
DEBUG=True

# Django安全密钥
# 用于加密会话数据、密码重置令牌等敏感信息
# 生产环境中必须设置为随机生成的复杂字符串
# 可使用命令生成: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=your-secret-key-here

# 允许访问的主机列表
# 生产环境中需要设置为实际的域名或IP地址
# 多个值用逗号分隔
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# 数据库连接设置 (MySQL)
# ============================================

# 数据库名称
DB_NAME=plant_care

# 数据库用户名
DB_USER=plantuser

# 数据库密码
DB_PASSWORD=plantpassword

# 数据库主机地址
# localhost表示本地数据库
# 远程数据库填写实际IP地址或域名
DB_HOST=localhost

# 数据库端口号
# MySQL默认端口为3306
DB_PORT=3306

# ============================================
# Redis缓存设置
# ============================================

# Redis连接URL
# 格式: redis://[密码@]主机:端口/数据库编号
# 数据库编号范围: 0-15
REDIS_URL=redis://localhost:6379/0

# ============================================
# 邮件发送设置
# ============================================

# SMTP服务器地址
# Gmail: smtp.gmail.com
# QQ邮箱: smtp.qq.com
# 163邮箱: smtp.163.com
EMAIL_HOST=smtp.gmail.com

# SMTP服务器端口
# TLS加密: 587
# SSL加密: 465
EMAIL_PORT=587

# 发送方邮箱地址
EMAIL_HOST_USER=your-email@gmail.com

# 邮箱密码或应用专用密码
# Gmail需要开启两步验证并创建应用专用密码
EMAIL_HOST_PASSWORD=your-app-password

# 是否使用TLS加密连接
# 配合端口587使用
EMAIL_USE_TLS=True

# ============================================
# API跨域设置
# ============================================

# 允许跨域请求的源地址
# 用于前端与后端分离的架构
# 多个地址用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ============================================
# 前端相关设置
# ============================================

# 前端调用API的基础URL
# Vue.js等前端框架使用此地址调用后端API
VUE_APP_API_URL=http://localhost:8000/api